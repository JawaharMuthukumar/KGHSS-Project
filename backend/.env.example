APP_NAME=GHSS Kangayampalayam API
API_V1_PREFIX=/api/v1
# Supabase: Connect -> Session pooler string, with the scheme changed to postgresql+psycopg2://
DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:5432/postgres?sslmode=require
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173
# Web push: generate a P-256 VAPID key pair; CRON_SECRET guards /push/reminders (called by an external cron)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://kghss-project.vercel.app
CRON_SECRET=
